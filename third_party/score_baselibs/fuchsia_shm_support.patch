+#ifndef SCORE_LIB_OS_FUCHSIA_SYS_ACL_H
+#define SCORE_LIB_OS_FUCHSIA_SYS_ACL_H
+
+// Fuchsia has no POSIX.1e ACLs and its sysroot has no <sys/acl.h>. This shim provides the subset used by
+// score/os/acl_impl.cpp. Every operation fails with ENOTSUP.
+
+#include <cerrno>
+#include <cstddef>
+#include <sys/types.h>
+
+struct fuchsia_acl_object;
+struct fuchsia_acl_entry_object;
+struct fuchsia_acl_permset_object;
+
+using acl_t = fuchsia_acl_object*;
+using acl_entry_t = fuchsia_acl_entry_object*;
+using acl_permset_t = fuchsia_acl_permset_object*;
+using acl_tag_t = int;
+using acl_perm_t = unsigned int;
+using acl_type_t = int;
+
+constexpr int ACL_UNDEFINED_TAG{0};
+constexpr int ACL_USER_OBJ{1};
+constexpr int ACL_USER{2};
+constexpr int ACL_GROUP_OBJ{4};
+constexpr int ACL_GROUP{8};
+constexpr int ACL_MASK{16};
+constexpr int ACL_OTHER{32};
+
+constexpr unsigned int ACL_READ{4U};
+constexpr unsigned int ACL_WRITE{2U};
+constexpr unsigned int ACL_EXECUTE{1U};
+
+constexpr int ACL_FIRST_ENTRY{0};
+constexpr int ACL_NEXT_ENTRY{1};
+constexpr acl_type_t ACL_TYPE_ACCESS{0x8000};
+
+namespace score::os::fuchsia_acl_detail
+{
+inline int NotSupported() noexcept
+{
+    errno = ENOTSUP;
+    return -1;
+}
+}  // namespace score::os::fuchsia_acl_detail
+
+inline acl_t acl_get_fd(const int) noexcept
+{
+    static_cast<void>(score::os::fuchsia_acl_detail::NotSupported());
+    return nullptr;
+}
+inline acl_t acl_get_file(const char*, const acl_type_t) noexcept
+{
+    static_cast<void>(score::os::fuchsia_acl_detail::NotSupported());
+    return nullptr;
+}
+inline int acl_create_entry(acl_t*, acl_entry_t*) noexcept { return score::os::fuchsia_acl_detail::NotSupported(); }
+inline int acl_get_entry(acl_t, const int, acl_entry_t*) noexcept { return score::os::fuchsia_acl_detail::NotSupported(); }
+inline int acl_get_tag_type(acl_entry_t, acl_tag_t*) noexcept { return score::os::fuchsia_acl_detail::NotSupported(); }
+inline int acl_set_tag_type(acl_entry_t, const acl_tag_t) noexcept { return score::os::fuchsia_acl_detail::NotSupported(); }
+inline void* acl_get_qualifier(acl_entry_t) noexcept
+{
+    static_cast<void>(score::os::fuchsia_acl_detail::NotSupported());
+    return nullptr;
+}
+inline int acl_set_qualifier(acl_entry_t, const void*) noexcept { return score::os::fuchsia_acl_detail::NotSupported(); }
+inline int acl_get_perm(acl_permset_t, const acl_perm_t) noexcept { return score::os::fuchsia_acl_detail::NotSupported(); }
+inline int acl_get_permset(acl_entry_t, acl_permset_t*) noexcept { return score::os::fuchsia_acl_detail::NotSupported(); }
+inline int acl_clear_perms(acl_permset_t) noexcept { return score::os::fuchsia_acl_detail::NotSupported(); }
+inline int acl_add_perm(acl_permset_t, const acl_perm_t) noexcept { return score::os::fuchsia_acl_detail::NotSupported(); }
+inline int acl_calc_mask(acl_t*) noexcept { return score::os::fuchsia_acl_detail::NotSupported(); }
+inline int acl_valid(acl_t) noexcept { return score::os::fuchsia_acl_detail::NotSupported(); }
+inline int acl_set_fd(const int, acl_t) noexcept { return score::os::fuchsia_acl_detail::NotSupported(); }
+inline int acl_free(void*) noexcept { return 0; }
+inline char* acl_to_text(acl_t, ssize_t*) noexcept
+{
+    static_cast<void>(score::os::fuchsia_acl_detail::NotSupported());
+    return nullptr;
+}
+
+#endif  // SCORE_LIB_OS_FUCHSIA_SYS_ACL_H
