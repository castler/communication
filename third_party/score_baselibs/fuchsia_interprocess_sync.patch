+constexpr std::uint32_t kYieldIterations{64U};
+constexpr std::int64_t kMinSleepNs{20'000};
+constexpr std::int64_t kMaxSleepNs{1'000'000};
+}  // namespace
+
+score::os::InterprocessConditionalVariable::InterprocessConditionalVariable() noexcept = default;
+
+score::os::InterprocessConditionalVariable::~InterprocessConditionalVariable() noexcept = default;
+
+auto score::os::InterprocessConditionalVariable::notify_one() noexcept -> void
+{
+    conditionalVariable.fetch_add(1U, std::memory_order_release);
+}
+
+auto score::os::InterprocessConditionalVariable::notify_all() noexcept -> void
+{
+    conditionalVariable.fetch_add(1U, std::memory_order_release);
+}
+
+auto score::os::InterprocessConditionalVariable::wait(std::unique_lock<InterprocessMutex>& lock) noexcept -> void
+{
+    if (!lock.owns_lock())
+    {
+        std::cerr << "Violated precondition. mutex needs to be locked before passing to conditional variable!";
+        std::abort();
+    }
+
+    // The generation is read while the mutex is held, so a notification issued after the unlock below (by someone who
+    // changed the predicate under the mutex) is never lost.
+    const auto generation = conditionalVariable.load(std::memory_order_acquire);
+    lock.unlock();
+    std::uint32_t iteration{0U};
+    std::int64_t sleep_ns{kMinSleepNs};
+    while (conditionalVariable.load(std::memory_order_acquire) == generation)
+    {
+        if (iteration < kYieldIterations)
+        {
+            ++iteration;
+            ::sched_yield();
+        }
+        else
+        {
+            static_cast<void>(::zx_nanosleep(::zx_deadline_after(sleep_ns)));
+            sleep_ns = (sleep_ns * 2 > kMaxSleepNs) ? kMaxSleepNs : sleep_ns * 2;
+        }
+    }
+    lock.lock();
+}
