// Attach and service discovery of LoLa on Fuchsia, see design/fuchsia/README.md section 6.3.
//
// Discovery carries information only (what is offered, in which epoch), never handles. Access is capability routing:
// every allowed consumer reaches a skeleton through its own routed `Endpoint` capability, the skeleton derives the
// consumer identity from the endpoint the connection arrived on.
library score.mw.com;

using zx;

type ServiceInstanceId = struct {
    service_id uint64;
    instance_id uint32;
    major_version uint8;
    minor_version uint8;
};

type Quality = flexible enum : uint8 {
    QM = 1;
    ASIL_B = 2;
};

/// Absent fields are wildcards.
type InstanceFilter = table {
    1: service_id uint64;
    2: instance_id uint32;
    3: major_version uint8;
    4: minor_version uint8;
    5: quality Quality;
};

type OfferedInstance = struct {
    id ServiceInstanceId;
    quality Quality;
    /// Incarnation of the skeleton, compare with `Endpoint.Attach().epoch`.
    epoch uint64;
};

const MAX_INSTANCES uint32 = 256;
const MAX_LAYOUT_SIZE uint32 = 4096;

type OfferError = flexible enum : uint32 {
    NOT_CONFIGURED = 1;
    ALREADY_OFFERED = 2;
};

type AttachError = flexible enum : uint32 {
    NOT_FOUND = 1;
    NOT_ALLOWED = 2;
    INCOMPATIBLE_VERSION = 3;
};

/// Skeleton -> discovery, one renamed capability per skeleton. Closing the channel (also on crash) withdraws every
/// offer of that skeleton.
@discoverable(name="score.mw.com.ServiceRegistry")
closed protocol ServiceRegistry {
    strict Offer(struct {
        id ServiceInstanceId;
        quality Quality;
        epoch uint64;
    }) -> () error OfferError;
    strict StopOffer(struct {
        id ServiceInstanceId;
        quality Quality;
    }) -> ();
};

/// Proxy -> discovery, one renamed capability per consumer. Answers only contain instances the caller may use.
@discoverable(name="score.mw.com.ServiceDiscovery")
closed protocol ServiceDiscovery {
    /// Snapshot of the currently offered instances matching `filter`.
    strict Find(struct {
        filter InstanceFilter;
    }) -> (struct {
        instances vector<OfferedInstance>:MAX_INSTANCES;
    });
    /// Cancelling the search is closing `search`.
    strict StartFind(resource struct {
        filter InstanceFilter;
        search server_end:Search;
    });
};

closed protocol Search {
    /// Hanging get. The first call returns the current snapshot at once, later calls return when the set or any epoch
    /// changed against the last reply. A second call while one is outstanding closes the channel.
    strict Watch() -> (struct {
        instances vector<OfferedInstance>:MAX_INSTANCES;
    });
};

/// Served by a skeleton at one path per allowed consumer and routed with `as` to a constant name. The consumer is
/// identified by the endpoint only, there is deliberately no application id in the request.
/// Typed markers (`compose score.mw.com.Endpoint`) are generated per service type, see realm_generator.
closed protocol Endpoint {
    /// Events are not a FIDL protocol: the skeleton publishes a slot in the shared data VMO and then signals
    /// ZX_EVENTPAIR_SIGNAL USER_0 on the peer of `notification`. The signal carries no payload (it is level triggered
    /// and coalescing, so a slow subscriber never blocks the publisher); what was published is read from the VMO.
    /// A subscriber that prefers to poll the VMO closes `notification`, which unsubscribes it.
    strict Attach() -> (resource struct {
        data_vmo zx.Handle:<VMO, zx.Rights.READ | zx.Rights.MAP | zx.Rights.GET_PROPERTY>;
        control_vmo zx.Handle:<VMO, zx.Rights.READ | zx.Rights.WRITE | zx.Rights.MAP | zx.Rights.GET_PROPERTY>;
        layout vector<uint8>:MAX_LAYOUT_SIZE;
        /// Copy of the epoch in the data VMO header, for the mismatch check against discovery.
        epoch uint64;
        /// Derived by the skeleton from the endpoint, not supplied by the caller.
        application_id uint64;
        /// Peer-closed means the skeleton is gone.
        liveness zx.Handle:<EVENTPAIR, zx.Rights.WAIT>;
        /// Per-subscriber wake-up. Wait for USER_0 (clear it, then re-read the VMO); peer-closed means the skeleton is
        /// gone. SIGNAL only allows clearing the own side, the skeleton's side cannot be signalled from here.
        notification zx.Handle:<EVENTPAIR, zx.Rights.WAIT | zx.Rights.SIGNAL>;
        /// Control region of the ASIL-B quality; absent when the skeleton offers QM only.
        control_asil_b_vmo zx.Handle:<VMO, zx.Rights.READ | zx.Rights.WRITE | zx.Rights.MAP | zx.Rights.GET_PROPERTY, optional>;
    }) error AttachError;
};
type BrokerError = flexible enum : uint32 {
    /// The instance has no ACTIVE incarnation (or none with that epoch).
    NOT_ACTIVE = 1;
    /// A skeleton incarnation of the instance is still provisioned or active.
    ALREADY_PROVISIONED = 2;
    /// Too many fenced incarnations are still pinned by live proxies.
    RESOURCE_EXHAUSTED = 3;
    /// The regions do not carry the expected incarnation header.
    INVALID_REGION = 4;
    STALE_EPOCH = 5;
};

/// Why an incarnation was fenced.
type FenceReason = flexible enum : uint8 {
    NONE = 0;
    RESIGNED = 1;
    PROCESS_TERMINATED = 2;
    LIVENESS_CLOSED = 3;
};

type BrokerStats = struct {
    /// 0 if no incarnation is provisioned or active.
    active_epoch uint64;
    last_epoch uint64;
    /// Incarnations whose VMOs the broker still holds (active + draining).
    retained_incarnations uint32;
    /// Fenced incarnations still pinned by live proxy leases.
    draining_incarnations uint32;
    live_proxy_leases uint32;
    fenced_total uint32;
    released_total uint32;
    last_fence_reason FenceReason;
    fenced_by_process uint32;
    fenced_by_liveness uint32;
};

/// Lease broker, one per realm slice (design/fuchsia/README.md section 6.5). Never on the data path: the broker retains
/// the regions of every skeleton incarnation, watches skeletons and proxies for termination and fences an incarnation
/// when its skeleton is gone (control header epoch := UINT64_MAX, `fenced` eventpair signalled USER_0). Regions are
/// handed to proxies by the skeleton's `Endpoint`, not by the broker.
///
/// Liveness of a holder is the peer-closed of the `liveness` eventpair it sends (needs no further right) and/or
/// ZX_PROCESS_TERMINATED of an optional process handle (needs WAIT, also tells crash from exit).
@discoverable(name="score.mw.com.Broker")
closed protocol Broker {
    /// Allocates the next epoch of the instance (strictly increasing, boot-clock based) and a skeleton lease.
    strict BeginIncarnation(resource struct {
        instance ServiceInstanceId;
        liveness zx.Handle:<EVENTPAIR, zx.Rights.WAIT>;
        process zx.Handle:<PROCESS, zx.Rights.WAIT, optional>;
    }) -> (struct {
        epoch uint64;
        skeleton_lease uint64;
    }) error BrokerError;
    /// Deposits the regions of `epoch`; the broker checks the incarnation header at the given offsets (magic and
    /// epoch, in both regions) before the incarnation becomes ACTIVE.
    strict Publish(resource struct {
        instance ServiceInstanceId;
        epoch uint64;
        data zx.Handle:<VMO, zx.Rights.READ | zx.Rights.MAP | zx.Rights.GET_PROPERTY>;
        control zx.Handle:<VMO, zx.Rights.READ | zx.Rights.WRITE | zx.Rights.MAP | zx.Rights.GET_PROPERTY>;
        data_header_offset uint64;
        control_header_offset uint64;
    }) -> () error BrokerError;
    /// Orderly StopOffer: fences at once.
    strict Resign(struct {
        instance ServiceInstanceId;
        epoch uint64;
    }) -> ();
    /// Proxy lease on `epoch`. `application_id` is informational (accounting/logging); the identity that grants access is
    /// still the routed `Endpoint`.
    strict RegisterProxy(resource struct {
        instance ServiceInstanceId;
        epoch uint64;
        application_id uint64;
        liveness zx.Handle:<EVENTPAIR, zx.Rights.WAIT>;
        process zx.Handle:<PROCESS, zx.Rights.WAIT, optional>;
    }) -> (resource struct {
        proxy_lease uint64;
        /// USER_0 = the incarnation is fenced. Peer-closed without USER_0 = broker lost, not skeleton lost.
        fenced zx.Handle:<EVENTPAIR, zx.Rights.WAIT>;
    }) error BrokerError;
    strict ReleaseLease(struct {
        proxy_lease uint64;
    }) -> ();
    /// Broker restart (state is soft): a live skeleton re-announces the incarnation `epoch` it got from the previous
    /// broker, with its still valid regions and fresh liveness/process handles. The broker verifies the headers and
    /// adopts the incarnation as ACTIVE; proxies then register again with RegisterProxy. Refused with
    /// ALREADY_PROVISIONED if the instance already has a live incarnation.
    strict Reannounce(resource struct {
        instance ServiceInstanceId;
        epoch uint64;
        data zx.Handle:<VMO, zx.Rights.READ | zx.Rights.MAP | zx.Rights.GET_PROPERTY>;
        control zx.Handle:<VMO, zx.Rights.READ | zx.Rights.WRITE | zx.Rights.MAP | zx.Rights.GET_PROPERTY>;
        data_header_offset uint64;
        control_header_offset uint64;
        liveness zx.Handle:<EVENTPAIR, zx.Rights.WAIT>;
        process zx.Handle:<PROCESS, zx.Rights.WAIT, optional>;
    }) -> (struct {
        skeleton_lease uint64;
    }) error BrokerError;
    strict Inspect(struct {
        instance ServiceInstanceId;
    }) -> (struct {
        stats BrokerStats;
    });
};
