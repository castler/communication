{
    include: [ "syslog/client.shard.cml" ],

    program: {
        runner: "elf",
        binary: "bin/echo_server",
        forward_stderr_to: "log",
        forward_stdout_to: "log",
    },

    capabilities: [
        { protocol: "score.messagepassing.Connector" },
    ],
    expose: [
        {
            protocol: "score.messagepassing.Connector",
            from: "self",
        },
    ],
}
