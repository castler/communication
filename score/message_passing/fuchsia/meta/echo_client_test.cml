{
    include: [
        "sys/testing/elf_test_runner.shard.cml",
        "syslog/client.shard.cml",
    ],

    program: {
        binary: "bin/echo_client_test",
    },

    children: [
        {
            name: "echo_server",
            url: "#meta/echo_server.cm",
        },
    ],
    offer: [
        {
            protocol: "fuchsia.logger.LogSink",
            from: "parent",
            to: "#echo_server",
        },
    ],
    use: [
        {
            protocol: "score.messagepassing.Connector",
            from: "#echo_server",
        },
    ],
}
