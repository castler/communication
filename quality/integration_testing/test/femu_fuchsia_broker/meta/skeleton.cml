{
    include: [ "syslog/client.shard.cml" ],

    program: {
        runner: "elf",
        binary: "bin/skeleton_main",
        forward_stderr_to: "log",
        forward_stdout_to: "log",
    },

    capabilities: [
        { protocol: "score.mw.com.Endpoint.for_app_4002" },
        { protocol: "score.mw.com.test.broker.Skeleton" },
    ],
    use: [
        { protocol: "score.mw.com.ServiceRegistry" },
        { protocol: "score.mw.com.Broker" },
    ],
    expose: [
        {
            protocol: [
                "score.mw.com.Endpoint.for_app_4002",
                "score.mw.com.test.broker.Skeleton",
            ],
            from: "self",
        },
    ],
}
