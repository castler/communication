{
    include: [ "syslog/client.shard.cml" ],

    program: {
        runner: "elf",
        binary: "bin/consumer_main",
        args: [ "rogue" ],
        forward_stderr_to: "log",
        forward_stdout_to: "log",
    },

    // No Endpoint is routed to this component, so it is not declared here either: the consumer connects to
    // /svc/score.mw.com.Endpoint anyway and must be refused.
    capabilities: [
        { protocol: "score.mw.com.test.Probe" },
    ],
    use: [
        { protocol: "score.mw.com.ServiceDiscovery" },
    ],
    expose: [
        {
            protocol: "score.mw.com.test.Probe",
            from: "self",
        },
    ],
}
