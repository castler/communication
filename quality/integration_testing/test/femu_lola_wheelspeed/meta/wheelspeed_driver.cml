{
    include: [
        "sys/testing/elf_test_runner.shard.cml",
        "syslog/client.shard.cml",
    ],

    program: {
        binary: "bin/wheelspeed_driver",
    },

    children: [
        {
            name: "discovery",
            url: "#meta/discovery.cm",
        },
        {
            name: "skeleton",
            url: "#meta/skeleton.cm",
        },
        {
            name: "proxy",
            url: "#meta/proxy.cm",
        },
    ],
    offer: [
        {
            protocol: "fuchsia.logger.LogSink",
            from: "parent",
            to: [
                "#discovery",
                "#proxy",
                "#skeleton",
            ],
        },

        {
            storage: "tmp",
            from: "parent",
            to: [
                "#proxy",
                "#skeleton",
            ],
        },

        // Per-caller capabilities: skeleton application 1000 may offer, consumer 4002 may find.
        {
            protocol: "score.mw.com.registry.for_app_1000",
            from: "#discovery",
            to: "#skeleton",
            as: "score.mw.com.ServiceRegistry",
        },
        {
            protocol: "score.mw.com.discovery.for_app_4002",
            from: "#discovery",
            to: "#proxy",
            as: "score.mw.com.ServiceDiscovery",
        },

        // The skeleton's endpoint for application 4002 is routed to the proxy only.
        {
            protocol: "score.mw.com.Endpoint.for_app_4002",
            from: "#skeleton",
            to: "#proxy",
            as: "score.mw.com.Endpoint",
        },
    ],
    use: [
        {
            protocol: "score.mw.com.wheelspeed.Probe",
            from: "#proxy",
            path: "/svc/probe",
        },
        {
            protocol: "fuchsia.component.Binder",
            from: "#skeleton",
            path: "/svc/skeleton_binder",
        },
    ],
}
