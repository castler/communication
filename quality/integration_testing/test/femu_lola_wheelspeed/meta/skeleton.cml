{
    include: [ "syslog/client.shard.cml" ],

    program: {
        runner: "elf",
        binary: "bin/wheelspeed_skeleton",
        args: [ "--count=500" ],
        forward_stderr_to: "log",
        forward_stdout_to: "log",
    },

    // The only Endpoint that exists is the one of application 4002 (the proxy).
    capabilities: [
        { protocol: "score.mw.com.Endpoint.for_app_4002" },
    ],
    use: [
        { protocol: "score.mw.com.ServiceRegistry" },
        { storage: "tmp", path: "/tmp" },
    ],
    expose: [
        { protocol: "score.mw.com.Endpoint.for_app_4002", from: "self" },

        // Lets the driver (re)start the skeleton, which exits after its samples.
        { protocol: "fuchsia.component.Binder", from: "framework" },
    ],
}
