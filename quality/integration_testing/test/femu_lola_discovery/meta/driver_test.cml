{
    include: [
        "sys/testing/elf_test_runner.shard.cml",
        "syslog/client.shard.cml",
    ],

    program: {
        binary: "bin/driver_test",
    },

    children: [
        {
            name: "discovery",
            url: "#meta/discovery.cm",
        },
        {
            name: "skeleton",
            url: "#meta/skeleton.cm",
        },
        {
            name: "proxy",
            url: "#meta/proxy.cm",
        },
    ],
    offer: [
        {
            protocol: "fuchsia.logger.LogSink",
            from: "parent",
            to: [
                "#discovery",
                "#proxy",
                "#skeleton",
            ],
        },
        {
            protocol: "score.mw.com.registry.for_app_1000",
            from: "#discovery",
            to: "#skeleton",
            as: "score.mw.com.ServiceRegistry",
        },
        {
            protocol: "score.mw.com.discovery.for_app_4002",
            from: "#discovery",
            to: "#proxy",
            as: "score.mw.com.ServiceDiscovery",
        },
    ],
    use: [
        {
            protocol: "score.mw.com.test.lola.Agent",
            from: "#skeleton",
            path: "/svc/agent_skeleton",
        },
        {
            protocol: "score.mw.com.test.lola.Agent",
            from: "#proxy",
            path: "/svc/agent_proxy",
        },
    ],
}
